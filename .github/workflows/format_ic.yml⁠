name: Format IC GeoJSON

on:
  workflow_dispatch:
    inputs:
      input_file:
        description: '変換元のGeoJSONファイルパス (例: json/N06-25_Joint.geojson)'
        required: true
        default: 'json/N06-25_Joint.geojson'
      output_file:
        description: '出力するJSONファイルパス (例: json/IC_formatted.json)'
        required: true
        default: 'json/IC_formatted.json'

jobs:
  format_json:
    runs-on: ubuntu-latest

    steps:
      # リポジトリのコードをチェックアウト
      - name: Checkout repository
        uses: actions/checkout@v3

      # Node.jsの環境をセットアップ
      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'

      # 変換スクリプトを実行 (指定されたパスを引数として渡す)
      - name: Run conversion script
        run: |
          node script/format_ic.js "${{ github.event.inputs.input_file }}" "${{ github.event.inputs.output_file }}"

      # 変更されたファイルをコミットしてプッシュ
      - name: Commit and push changes
        run: |
          git config --global user.name 'github-actions[bot]'
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'
          git add "${{ github.event.inputs.output_file }}"
          git commit -m "Auto-format: formatted ${{ github.event.inputs.input_file }}" || echo "No changes to commit"
          git push
