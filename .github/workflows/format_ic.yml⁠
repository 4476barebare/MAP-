name: Format IC GeoJSON

on:
  workflow_dispatch:
    inputs:
      target_file:
        description: '処理対象のGeoJSONファイル名（例: N06-25_Joint.geojson）'
        required: true
        default: 'N06-25_Joint.geojson'

jobs:
  format-ic:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'

      - name: Run script to format IC GeoJSON
        run: node script/format_ic.js "json/${{ github.event.inputs.target_file }}"

      - name: Commit and push changes
        run: |
          git config --global user.name "GitHub Actions"
          git config --global user.email "actions@github.com"
          git add .
          
          if ! git diff-index --quiet HEAD; then
            git commit -m "Chore: json/${{ github.event.inputs.target_file }} をスリム化"
            git push
          else
            echo "変更がありませんでした。"
          fi
