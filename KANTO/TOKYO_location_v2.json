{"v":2,"pref":{"code":"TOKYO","name":"東京都","lat":35.765,"lng":139.53,"zoom":9,"jmaCode":"130000"},"areas":{"TOKYO_HARUMI":{"id":"HARUMI","name":"臨海都心エリア","lat":35.661,"lng":139.758,"zoom":10.5,"grid":{"x":1,"y":0},"desc":"「釣りを始めてみたいけど、遠くの海まで行くのは大変そう…」そんな初心者さんにぴったり！都心部というと高層ビルが立ち並び「釣り場なんて無さそう」というイメージを持たれがちですが、実は東京湾に面した臨海エリアには、電車でサクッとアクセスできる釣りスポットがたくさんあります。綺麗に整備された海浜公園の護岸など、足場が良く安全に楽しめる場所が多く、江戸前ならではの小物釣りをのんびりと満喫できます。特におすすめなのが、夏から秋にかけての「ハゼ釣り」。簡単な仕掛けでピクピクッというアタリが分かりやすく、お子様や初めての方でも釣果を上げやすいのが特徴です。"},"TOKYO_OKUTAMA":{"id":"OKUTAMA","name":"奥多摩八王子エリア","lat":35.7075,"lng":139.3128,"zoom":10,"grid":{"x":0,"y":0},"desc":"都会の喧騒から離れ緑豊かな清流が広がるエリア。最大の魅力はマイナスイオンたっぷりの大自然の中、初心者でも気軽に「手ぶら」で訪れることができるマス釣り堀が充実していること！面倒な事前準備は一切不要で、レンタル竿とエサですぐに釣りが始められます。澄み切った川のせせらぎを聞きながらのんびり糸を垂らせば、日々の疲れも吹き飛びます。釣ったばかりの新鮮な魚をその場で調理して味わえる施設が多いのも嬉しいポイント。美しい自然と触れ合いながら、心も体も満たされる癒しの休日を過ごせます。"}},"spots":{"葛西臨海公園":{"id":"1","areaId":"TOKYO_HARUMI","lat":35.649556,"lng":139.860463,"zoom":14,"icon":"spot","type":"assistant","tags":["海水","公園"]},"お台場周辺":{"id":"2","areaId":"TOKYO_HARUMI","lat":35.622837,"lng":139.780641,"zoom":14,"icon":"spot","type":"substitute","tags":["海水","市街地"]},"新川":{"id":"3","areaId":"TOKYO_HARUMI","lat":35.67517,"lng":139.870435,"zoom":14.5,"icon":"spot","tags":["汽水","市街地"]},"隅田川周辺":{"id":"4","areaId":"TOKYO_HARUMI","lat":35.667343,"lng":139.785104,"zoom":14,"icon":"spot","type":"representative","tags":["海水","市街地","河口"]},"豊洲周辺":{"id":"5","areaId":"TOKYO_HARUMI","lat":35.648998,"lng":139.783988,"zoom":14,"icon":"spot","tags":["海水","市街地","運河"]},"新木場周辺":{"id":"6","areaId":"TOKYO_HARUMI","lat":35.641838,"lng":139.832078,"zoom":14.5,"icon":"spot","tags":["海水","市街地","運河"]},"芝浦周辺":{"id":"7","areaId":"TOKYO_HARUMI","lat":35.638433,"lng":139.751662,"zoom":14.5,"icon":"spot","tags":["海水","市街地","運河"]},"清砂大橋":{"id":"8","areaId":"TOKYO_HARUMI","lat":35.66943,"lng":139.846473,"zoom":14,"icon":"spot","tags":["海水","閑静","河口"]},"辰巳運河周辺":{"id":"9","areaId":"TOKYO_HARUMI","lat":35.654757,"lng":139.811686,"zoom":14.5,