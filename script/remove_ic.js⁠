const fs = require('fs');

// 対象のJSONファイル名（ご自身の環境に合わせて変更してください）
const inputFile = '神奈川2回目.json'; 
const outputFile = '神奈川2回目_IC削除.json'; // 上書きする場合は inputFile と同じ名前にします

try {
  // JSONファイルの読み込み
  const rawData = fs.readFileSync(inputFile, 'utf-8');
  const data = JSON.parse(rawData);

  // カテゴリが「IC」以外のものを抽出（＝ICを削除）
  const filteredData = data.filter(item => item.category !== 'IC');

  // 新しいJSONとして保存
  fs.writeFileSync(outputFile, JSON.stringify(filteredData, null, 2), 'utf-8');

  console.log(`処理完了: 元のデータ ${data.length}件 -> 処理後 ${filteredData.length}件`);
  console.log(`削除されたICの数: ${data.length - filteredData.length}件`);
} catch (error) {
  console.error('エラーが発生しました:', error);
}
